# =============================================================================
# BAALEBOS CLOUD — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# --- App ---
ENVIRONMENT=development        # development | production

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=jobhunter
DATABASE_URL=postgresql://postgres:your_postgres_password@db:5432/jobhunter

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Security ---
SECRET_KEY=replace_with_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Groq AI, primary provider (https://console.groq.com; free tier has rate limits) ---
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- Optional backup providers: used when Groq is rate limited or refuses a request ---
# Model names must exist in the provider's current catalogue (they are retired over time).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email (optional — for notifications) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- App ---
DEBUG=False
OUTPUT_DIR=/app/output

# --- Job automation (disabled until a webhook and secret are configured) ---
N8N_EVENTS_WEBHOOK_URL=
# Legacy application-only workflow remains supported.
N8N_APPLICATION_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Existing scraper normally runs every 6h; warn after 8h without a heartbeat.
SCRAPER_STALE_HOURS=8
