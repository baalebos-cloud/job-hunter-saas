# =============================================================================
# BAALEBOS CLOUD — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# --- App ---
ENVIRONMENT=development        # development | production

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=jobhunter
DATABASE_URL=postgresql://postgres:your_postgres_password@db:5432/jobhunter

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Security ---
SECRET_KEY=replace_with_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Groq AI (free & unlimited — https://console.groq.com) ---
GROQ_API_KEY=gsk_your_groq_key_here

# --- Optional AI keys (not required if using Groq) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Email (optional — for notifications) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- App ---
DEBUG=False
OUTPUT_DIR=/app/output
