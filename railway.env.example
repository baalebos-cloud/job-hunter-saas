# =============================================================================
# BAALEBOS CLOUD — Railway Environment Variables
# =============================================================================
# Add ALL of these in your Railway service dashboard under:
#   Service → Variables → Add Variable
#
# Railway auto-injects DATABASE_URL and REDIS_URL when you add
# PostgreSQL and Redis plugins to your project — do NOT set those manually.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
PYTHONPATH=/app
OUTPUT_DIR=/app/output

# ── Frontend URL (your Vercel domain) ────────────────────────────────────────
# Railway uses this for CORS — set to your actual Vercel URL
FRONTEND_URL=https://baalebo.xyz

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string_at_least_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── AI (Groq — free at console.groq.com) ─────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key_here

# ── Email ────────────────────────────────────────────────────────────────────
# Verification emails (candidate and HR sign-up) use Resend's HTTPS API.
# Railway Hobby blocks outbound SMTP, so without RESEND_API_KEY no verification
# email is delivered. EMAILS_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=re_your_resend_api_key
EMAILS_FROM_EMAIL=noreply@baalebo.xyz
EMAILS_FROM_NAME=Baalebos Cloud
# Receives "new HR signup awaiting approval" alerts.
ADMIN_EMAIL=you@baalebo.xyz
# SMTP (implicit TLS) for the other emails: HR approval, admin alerts, welcome,
# password reset. Needs a Railway plan that allows outbound SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
# Legacy Gmail sender, read only by services/notification_service.py.
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=your_gmail@gmail.com

# ── These are AUTO-SET by Railway plugins — DO NOT add manually ──────────────
# DATABASE_URL   ← set automatically when you add PostgreSQL plugin
# REDIS_URL      ← set automatically when you add Redis plugin
# PORT           ← set automatically by Railway for each service

# --- Job automation (disabled until a webhook and secret are configured) ---
N8N_EVENTS_WEBHOOK_URL=
# Legacy application-only workflow remains supported.
N8N_APPLICATION_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Existing scraper normally runs every 6h; warn after 8h without a heartbeat.
SCRAPER_STALE_HOURS=8
