# =============================================================================
# BAALEBOS CLOUD — Railway Environment Variables
# =============================================================================
# Add ALL of these in your Railway service dashboard under:
#   Service → Variables → Add Variable
#
# Railway auto-injects DATABASE_URL and REDIS_URL when you add
# PostgreSQL and Redis plugins to your project — do NOT set those manually.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
PYTHONPATH=/app
OUTPUT_DIR=/app/output

# ── Frontend URL (your Vercel domain) ────────────────────────────────────────
# Railway uses this for CORS — set to your actual Vercel URL
FRONTEND_URL=https://baalebo.xyz

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string_at_least_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── AI (Groq — free at console.groq.com) ─────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key_here

# ── Email (optional — Gmail App Password) ────────────────────────────────────
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=your_gmail@gmail.com

# ── These are AUTO-SET by Railway plugins — DO NOT add manually ──────────────
# DATABASE_URL   ← set automatically when you add PostgreSQL plugin
# REDIS_URL      ← set automatically when you add Redis plugin
# PORT           ← set automatically by Railway for each service
