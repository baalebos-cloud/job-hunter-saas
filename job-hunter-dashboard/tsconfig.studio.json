{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["src/studio/**/*.ts", "src/studio/**/*.tsx"]
}
